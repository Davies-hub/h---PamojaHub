# API base URL for the frontend.
#
# BAKE-TIME variable: EXPO_PUBLIC_* values are inlined into the JS bundle when
# Metro starts — set it IN THE SHELL before `npx expo run:android` / `npx expo start`
# (a .env change alone does nothing to an already-running Metro; restart with --clear).
#
# The localhost fallback only works for LAPTOP WEB. On a physical phone,
# localhost is the PHONE itself — use your laptop's LAN IP (ipconfig), and make
# sure it's in backend ALLOWED_HOSTS and the backend runs on 0.0.0.0:8000.
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1

# Pamoja Hub — Backend Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to git. This file (.env.example) is safe to commit.
# Documents the variable structure only — values are intentionally blank.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Safaricom Daraja ──────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# ⚠️ CALLBACK URLS MUST CARRY THE SECRET SEGMENT (learned the hard way 2026-07-09):
# the callback routes mount at callback/<MPESA_CALLBACK_SECRET>/ and
# b2c-result/<MPESA_CALLBACK_SECRET>/, so MPESA_CALLBACK_URL and
# MPESA_B2C_RESULT_URL must END with that same segment (e.g.
# https://host/api/v1/donations/callback/<secret>/) — a bare path means
# Safaricom's real callbacks 404 at the router and money silently never settles.
# The same applies to the URLs registered with Safaricom at production go-live.
MPESA_CALLBACK_URL=
MPESA_B2C_QUEUE_URL=
MPESA_B2C_RESULT_URL=
# Secret path segment for the three payment-callback routes (see warning above).
# Dev falls back to 'dev-callback-secret' (config/settings/development.py);
# REQUIRED non-empty in production (validate_env refuses to start without it).
MPESA_CALLBACK_SECRET=
MPESA_ENVIRONMENT=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
# B2C org shortcode — distinct from the STK MPESA_SHORTCODE (sandbox: 600xxx).
MPESA_B2C_SHORTCODE=
MPESA_FLOAT_ALERT_THRESHOLD=

# ── Africa's Talking ──────────────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=

# ── Platform Settings ─────────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=

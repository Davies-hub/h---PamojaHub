# Pamoja Hub — Backend Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to git. This file (.env.example) is safe to commit.
# The application will refuse to start if any required variable is missing.

# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-minimum-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost/pamoja_dev

# ── Safaricom Daraja ──────────────────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_daraja_passkey_here

# ── Callback secret path segment ──────────────────────────────────────────
# All THREE payment-callback routes (donation, subscription, B2C result) require
# this secret segment. It MUST match the /<segment>/ at the end of the callback
# URLs below AND the URLs you register in the Daraja portal — otherwise the real
# Safaricom callback 404s. REQUIRED in production (startup fails if empty); may be
# left empty in development (routes fall back to the bare path). Treat as a secret.
MPESA_CALLBACK_SECRET=REPLACE-WITH-CALLBACK-SECRET

# Set these to your ngrok HTTPS URL in development; your real domain in production.
# Each path ENDS WITH the MPESA_CALLBACK_SECRET segment above (kept in sync by hand).
MPESA_CALLBACK_URL=https://REPLACE-WITH-NGROK-URL.ngrok.io/api/v1/donations/callback/REPLACE-WITH-CALLBACK-SECRET/
# B2C async payout RESULT URL. Route is /api/v1/withdrawals/b2c-result/<secret>/.
MPESA_B2C_RESULT_URL=https://REPLACE-WITH-NGROK-URL.ngrok.io/api/v1/withdrawals/b2c-result/REPLACE-WITH-CALLBACK-SECRET/
# QueueTimeOutURL is still sent to Daraja, but NOTE: no /b2c-queue/ route is
# currently mounted (the timeout callback routes nowhere — tracked as a separate
# bug, out of scope for this slice). Kept here because validate_env still requires it.
MPESA_B2C_QUEUE_URL=https://REPLACE-WITH-NGROK-URL.ngrok.io/api/v1/withdrawals/b2c-queue/
# Subscription STK callback. Defaults from MPESA_CALLBACK_URL with the path swapped
# to /subscriptions/callback/<secret>/ (the secret carries over automatically);
# set explicitly only to override. Route is /api/v1/subscriptions/callback/<secret>/.
# MPESA_SUBSCRIPTION_CALLBACK_URL=https://REPLACE-WITH-NGROK-URL.ngrok.io/api/v1/subscriptions/callback/REPLACE-WITH-CALLBACK-SECRET/

# sandbox or production
MPESA_ENVIRONMENT=sandbox

MPESA_B2C_INITIATOR_NAME=your_b2c_initiator_name
MPESA_B2C_SECURITY_CREDENTIAL=your_b2c_security_credential_here

# Alert threshold in KES — Super Admin is alerted when float drops below this
MPESA_FLOAT_ALERT_THRESHOLD=50000

# ── Africa's Talking ──────────────────────────────────────────────────────
# Get from https://africastalking.com — used ONLY for Campaign Treasurer OTP SMS
# Use username=sandbox and sandbox API key for development
AT_API_KEY=your_africastalking_api_key_here
AT_USERNAME=sandbox

# ── Resend ────────────────────────────────────────────────────────────────
# Get from https://resend.com — used for transactional emails only
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Frontend ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:19006

# ── Platform Settings ─────────────────────────────────────────────────────
# Transaction fee percentage (default 2.5%)
PLATFORM_FEE_PERCENT=2.5
